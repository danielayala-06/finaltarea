<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#dfe6e9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="REGISTRO DE HERRAMIENTAS"
            android:textSize="16dp"
            android:layout_marginVertical="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!--NOMBRE-->
        <EditText
            android:id="@+id/edtTitulo"
            android:hint="Titulo"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!--MARCA-->
        <EditText
            android:id="@+id/edtDuracion"
            android:hint="Duracion"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerGeneros"
            android:hint="Genero"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

       <!-- <EditText
            android:id="@+id/edtGenero"
            android:hint="Genero"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/> -->

        <EditText
            android:id="@+id/edtLanzamiento"
            android:hint="Lanzamiento"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnGuardarPeliculas"
            android:text="Guardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnResetPeliculas"
            android:text="Limpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>